<?xml version="1.0" encoding="utf-8"?>
<!-- One display in the DPI list: a rectangle in its own proportions, its pixel size and the DPI
     kept for it. Tapping opens the DPI screen for that display. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/settingsContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/settingsOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <View
                android:id="@+id/previewRect"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dpi_preview" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginLeft="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/displayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/settingsOnSurface"
                android:textSize="@dimen/settings_row_title_size"
                tools:text="1812 × 2176 px" />

            <TextView
                android:id="@+id/displayValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/settingsOnSurfaceVariant"
                android:textSize="@dimen/settings_row_description_size"
                tools:text="420 DPI" />
        </LinearLayout>

        <TextView
            android:id="@+id/displayBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_dpi_badge"
            android:paddingStart="7dp"
            android:paddingLeft="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingRight="7dp"
            android:paddingBottom="2dp"
            android:text="@string/dpi_screens_badge_this"
            android:textColor="@color/splash_text_white"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:layout_width="@dimen/settings_row_icon_size"
            android:layout_height="@dimen/settings_row_icon_size"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_sym_chevron_right"
            app:tint="?attr/settingsOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
